use crate::{state::State, transactions::{Transaction, TransactionType}};

pub fn process(state: &mut State, transaction: Transaction) {

    // Get transaction information
    let transaction_type = transaction.transaction_type();

    // Process transaction in the account
    match transaction_type {
        TransactionType::Deposit => state.deposit(&transaction),
        TransactionType::Withdrawal => state.withdraw(&transaction),
        TransactionType::Dispute => state.dispute(&transaction),
        TransactionType::Resolve => state.resolve(&transaction),
        TransactionType::Chargeback => state.chargeback(&transaction),
    }

    // Save transaction state
    // TODO: do a Result vs. Error here
    state.save_transaction(transaction);

}